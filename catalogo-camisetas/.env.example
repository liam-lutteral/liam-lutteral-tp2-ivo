# Credenciales de Supabase (se exponen al cliente por prefijo PUBLIC_)
PUBLIC_SUPABASE_URL="https://tu-proyecto.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="tu-anon-key-publica"

# --- SMTP (Resend) para Supabase Auth ---
# No se usan en el código: se configuran en el dashboard de Supabase
# (Authentication > SMTP Settings) para que los mails de confirmación
# salgan siempre y no dependan del rate-limit del mailer interno.
# RESEND_SMTP_HOST="smtp.resend.com"
# RESEND_SMTP_PORT="465"
# RESEND_SMTP_USER="resend"
# RESEND_SMTP_PASSWORD="re_..."

# --- Tests E2E (opcionales) ---
# El email debe pertenecer a un dominio aceptado por tu proyecto Supabase.
# Por defecto se genera uno con el dominio indicado en E2E_EMAIL_DOMAIN.
# E2E_TEST_EMAIL="test-e2e@tudominio.com"
# E2E_TEST_PASSWORD="TestPass123!"
# E2E_EMAIL_DOMAIN="gmail.com"
